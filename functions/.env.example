# نمونه‌ی تنظیمات غیرمحرمانه — این فایل را کپی کنید به: functions/.env  و مقدارها را پر کنید.
# ⚠️ کلید API را هرگز اینجا ننویسید. کلید فقط با دستور زیر ثبت می‌شود:
#    firebase functions:secrets:set AI_API_KEY
# (برای اجرای محلی: فایل .secret.local.example را ببینید.)

# سرویس: anthropic | openai | openai_compatible
AI_PROVIDER=anthropic

# نام مدل (الزامی؛ مقدار نمونه — با مدل موردنظر خودتان جایگزین کنید)
AI_MODEL=claude-sonnet-5-5

# فقط برای openai_compatible الزامی است، یا اگر آدرس پیش‌فرض سرویس را می‌خواهید عوض کنید (فقط https)
# AI_BASE_URL=https://example.com/v1

# سقف خروجی هر درخواست (۱ تا ۶۴۰۰۰) | مهلت به میلی‌ثانیه (۱۰۰۰ تا ۱۲۰۰۰۰) | سقف روزانه برای هر کاربر (۰ تا ۱۰۰۰۰)
AI_MAX_TOKENS=1000
AI_TIMEOUT_MS=30000
AI_DAILY_LIMIT=50

# کلید قطع اضطراری: false یعنی هوش مصنوعی غیرفعال
AI_ENABLED=true

# مبدأ سایت شما (برای CORS)، جداشده با ویرگول. مثال: https://username.github.io
AI_ALLOWED_ORIGINS=

# منطقه‌ی اجرای تابع (پیش‌فرض europe-west1)
# AI_REGION=europe-west1
